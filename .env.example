# Supabase project that handles auth (Dashboard -> Settings -> API).
# Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY JWTs are also accepted.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Postgres connection for Prisma (data storage).
# Local dev:  postgresql://postgres:postgres@127.0.0.1:54332/postgres  (npx supabase start)
# Hosted:     Dashboard -> Connect -> ORMs (Prisma) -> pooled connection string
# NOTE (hosted): the transaction pooler (port 6543, ?pgbouncer=true) is for the
# running app. Schema changes (npm run db:setup) hang on it; run them with the
# session pooler: same string, port 5432, no ?pgbouncer=true.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54332/postgres"
